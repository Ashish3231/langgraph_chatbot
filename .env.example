# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: override the default model (gpt-4.1)
# OPENAI_MODEL=gpt-4o

# PostgreSQL connection URL for the database and document tools.
# Default if unset: postgresql://postgres:postgres@localhost:5432/chatbot
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot

# No key is needed for web_search - it uses DuckDuckGo via the `ddgs` package.

# Document search embeds text with Google's Gemini embedding model.
# Create a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
