# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: override the default model (gpt-4.1)
# OPENAI_MODEL=gpt-4o

# PostgreSQL connection URL for the database tools.
# Default if unset: postgresql://localhost/langgraph_demo
# DATABASE_URL=postgresql://user:password@localhost:5432/langgraph_demo

# No key is needed for web_search - it uses DuckDuckGo via the `ddgs` package.
