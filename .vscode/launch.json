{
  // https://go.microsoft.com/fwlink/?linkid=830387
  //
  // app/main.py does `from app.graph import ...`, so it must be run as a
  // MODULE (python -m app.main) from the project root, not as a plain file
  // path. Running the file directly puts app/ on sys.path instead of the
  // project root, and the import fails with "No module named 'app'".
  "version": "0.2.0",
  "configurations": [
    {
      // The one you want most of the time. Set a breakpoint in app/graph.py
      // or app/tools.py and press F5.
      "name": "Agent: chat loop",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Same thing, but VS Code prompts for a question to send. Everything you
      // type becomes sys.argv, so the agent answers once and exits.
      "name": "Agent: single question",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}",
      "justMyCode": true
    },
    {
      // Loads ./documents into the vector database.
      "name": "Loader: index ./documents",
      "type": "debugpy",
      "request": "launch",
      "module": "app.loader",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // justMyCode:false lets you step down into langgraph/langchain source,
      // which is how you see what the framework does with your state.
      "name": "Agent: step into libraries",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // For debugging a standalone script you have open. Not for app/main.py.
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // Attach to an already-running process, e.g. `langgraph dev`.
      "name": "Python: attach to process",
      "type": "debugpy",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
